// Prisma Client Generator
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Database
datasource db {
  provider = "postgresql"
}

//////////////////////
// ENUMS
//////////////////////

enum OrganizationType {
  SCHOOL
  HOSPITAL
  MUNICIPALITY
  POLICE_STATION
  PRIVATE
}

enum OrganizationMemberRole {
  ADMIN
  DRIVER
  VIEWER
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  BUS
  OTHER
}

enum AccidentStatus {
  REPORTED
  CONFIRMED
  RESOLVED
}

enum AlertType {
  SMS
  PUSH
  EMAIL
}

//////////////////////
// MODELS
//////////////////////

model User {
  id          String @id @default(uuid())
  phoneNumber String @unique
  password    String
  isActive    Boolean @default(true)
  isVerified Boolean @default(false)
  verificationCode String?
  fullName String?
  memberships OrganizationMember[]
  vehicles    Vehicle[] @relation("DriverVehicles")
  invitations Invitation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id               String @id @default(uuid())
  name             String
  address          String
  phoneNumber      String
  organizationType OrganizationType
  invitations Invitation[]
  members          OrganizationMember[]
  vehicles         Vehicle[]
  accidents        Accident[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OrganizationMember {
  id             String @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
}

model Vehicle {
  id             String @id @default(uuid())
  vehicleNumber  String
  vehicleType    VehicleType
  vehicleModel   String @default("")
  ipAddress      String?
  port           Int?    @default(81)

  driverId       String
  organizationId String

  driver         User @relation("DriverVehicles", fields: [driverId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  accidents      Accident[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, vehicleNumber])
}

model Accident {
  id             String @id @default(uuid())
  title          String
  description    String?
  latitude       Float
  longitude      Float
  occurredAt     DateTime
  status         AccidentStatus

  vehicleId      String
  organizationId String

  vehicle        Vehicle @relation(fields: [vehicleId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Alert {
  id        String @id @default(uuid())
  type      AlertType
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Invitation{
  id String @id @default(uuid())
  userId String
  organizationId String
  createdAt DateTime @default(now())
  inviteRole OrganizationMemberRole
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  @@unique([userId, organizationId])
}